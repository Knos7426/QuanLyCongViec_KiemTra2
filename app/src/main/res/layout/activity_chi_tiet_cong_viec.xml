<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHI TIET CONG VIEC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="20dp" />

    <TextView
        android:id="@+id/tvThongTinCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thong tin cong viec"
        android:textSize="18sp" />

    <CheckBox
        android:id="@+id/chkDaHoanThanh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh dau cong viec da hoan thanh" />

    <Button
        android:id="@+id/btnHoanThanh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hoan thanh" />

    <Button
        android:id="@+id/btnChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chinh sua" />

</LinearLayout>